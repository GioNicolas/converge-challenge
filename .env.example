FEATHERLESS_API_KEY=
ANALYST_MODEL=zai-org/GLM-5.3-Flash
EVALUATOR_MODEL=zai-org/GLM-5.2
FAST_MODEL=google/gemma-4-31B-it
INTERVIEWER_MODEL=zai-org/GLM-5.3-Flash

# Reserva: só entra quando a Featherless falha ou demora demais
OPENROUTER_API_KEY=
ANALYST_FALLBACK_MODEL=z-ai/glm-5.3-flash
FAST_FALLBACK_MODEL=openai/gpt-oss-120b
EVALUATOR_FALLBACK_MODEL=z-ai/glm-5.2
INTERVIEWER_FALLBACK_MODEL=z-ai/glm-5.3-flash
# Fala ao vivo com o candidato (quadro e live coding): OpenRouter primário, Featherless de reserva.
# Escolhido com scripts/bench-conversa.ts (rápido e segue as regras de fala). Vazio = o padrão do código.
CONVERSA_AO_VIVO_MODEL=google/gemini-3.5-flash-lite
CONVERSA_AO_VIVO_RESERVA_MODEL=zai-org/GLM-5.3-Flash
# Filtro de fala do live coding (spoiler/validação), no caminho de cada resposta.
FILTRO_MODEL=google/gemini-3.5-flash-lite
FILTRO_RESERVA_MODEL=google/gemma-4-31B-it

# Pré-entrevista (Totti)
TYPESAFE_API_KEY=
EXTRACTOR_MODEL=zai-org/GLM-5.2
EXTRACTOR_FALLBACK_MODEL=google/gemini-2.5-flash-lite
CONVERSA_MODEL=google/gemma-4-26B-A4B-it
CONVERSA_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Quadro Excalidraw e pré-entrevista: 1 (padrão) = chamam as rotas reais; 0 = demonstração roteirizada, sem servidor.
NEXT_PUBLIC_USAR_SERVIDOR=1
# Slack (lib/slack) — sem SLACK_BOT_TOKEN roda em modo simulado (só loga).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# URL pública da sala de entrevista (provisório até a chamada própria existir)
APP_BASE_URL=http://localhost:3000

# Email (lib/email) — domínio interview.entoa.app verificado no Resend.
# Sem RESEND_API_KEY o envio é simulado apenas fora de produção; em produção
# falhas viram erro 502.
RESEND_API_KEY=
# Nome de pessoa/time no remetente: nome de produto ("Converge Challenge") tem mais cara de marketing.
EMAIL_FROM="Time de Recrutamento <entrevistas@interview.entoa.app>"
# Segredo compartilhado exigido no header x-api-key das rotas /api/email/*.
# Sem ele, as rotas respondem 401 (fail closed).
EMAIL_API_SECRET=
# Recomendado: caixa real pra onde vão as respostas dos candidatos (interview.entoa.app não recebe e-mail).
# Um reply-to que funciona ajuda a reputação e libera o "é só responder" nos e-mails.
EMAIL_REPLY_TO=
# Opcional: fuso exibido nos emails (padrão America/Sao_Paulo).
EMAIL_TIMEZONE=

# Só para a demo do Slack (/api/slack/demo): todos os emails de teste vão para este endereço.
DEMO_EMAIL=

# --- Cérebro do quadro (lib/agente): usa o lib/llm (Featherless primária, OpenRouter de reserva) ---
# Papéis: análise ao vivo = ANALYST_*; perguntas e abertura = INTERVIEWER_*; scorecard, kits e plano = EVALUATOR_*.
# Os modelos e as chaves ficam nas variáveis da seção do lib/llm, acima.
# Segredo exigido no header x-api-key das rotas /api/avaliacoes/*. Sem ele, 401 (fail closed).
AVALIACOES_API_SECRET=
# Scorecard: prazo total em ms, incluindo retry. Padrão 120000; intervalo permitido 1..240000.
# A rota /finalizar tem maxDuration de 300 s, o que deixa folga para salvar o resultado.
AGENTE_TIMEOUT_SCORECARD_MS=
# 1 = permite abrir sessão para uma avaliação GERADA ainda não aprovada (só para demos/testes).
# Padrão: sessões de avaliações geradas exigem aprovação humana (POST /api/avaliacoes/[id]/aprovar).
AGENTE_PERMITIR_NAO_APROVADA=
# 1 = LLM falso determinístico, sem chave (só para testar o fluxo).
AGENTE_FAKE=
# 1 = libera rotas /dev e o scorecard no navegador mesmo em produção.
AGENTE_DEV=

NEXT_PUBLIC_AVALIACAO_ID=demo
NEXT_PUBLIC_CANDIDATO_ID=demo

# Candidatos de teste: aparecem como inscritos em toda vaga. Vazio = o time (Lucas, Sofia, Henrique e Giorgio).
# E-mail de verdade só sai para o Lucas (lib/convites/teste.ts); os outros ficam simulados.
# Formato: Nome Sobrenome <email>; Outro Nome <email2>
CANDIDATOS_TESTE=
# Opcional: URL pública do app nos links dos emails (padrão: a origem da requisição).
APP_URL=

# Transcrição da fala do candidato (rota /api/stt-token): a chave fica só no servidor.
# O navegador recebe apenas um token temporário e usa o Scribe em tempo real; sem chave,
# ou com NEXT_PUBLIC_USAR_SERVIDOR=0 (demonstração), cai na transcrição do navegador.
ELEVENLABS_API_KEY=

# Voz do agente (rota /api/falar): ID da voz em Voices, no painel do ElevenLabs.
# Sem ELEVENLABS_API_KEY a rota responde 501 e o quadro usa a voz do navegador.
# Opcional: troca a voz. Sem isso o agente usa a Fernando - Casual (pt-BR, voz da biblioteca:
# exige plano pago na API).
ELEVENLABS_VOICE_ID=
# Opcional: modelo de voz (padrão eleven_flash_v2_5, o mais rápido).
ELEVENLABS_MODEL_ID=

# A página de agendamento oferece também dois horários daqui a 3 e 5 minutos (rótulo "teste"), pra testar o
# fluxo inteiro na hora. Ligados por padrão (fase de testes); 0 desliga. O POST aceita qualquer minuto cheio
# entre 5 min atrás e 15 min à frente. Desligue antes de usar com candidatos de verdade.
HORARIOS_DE_TESTE=

# Senha do painel da recrutadora (opcional). Definida, o navegador pede usuário (qualquer um) e esta senha para abrir
# /vagas, /pre-entrevista, /report, /relatorio e as rotas que os alimentam. O candidato nunca passa por ela.
# Vazia: o painel fica aberto. Ver docs/acesso-do-painel.md.
PAINEL_SENHA=

# Armazenamento no Supabase (ver docs/supabase.md): planos, convites, relatórios, sessões do System Design,
# kits gerados e desenhos. Sem estas duas, tudo fica em memória e na pasta data/ (como antes).
# A chave é a secret (sb_secret_...) ou a service_role: só no servidor, nunca em NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# memoria = ignora o Supabase mesmo com as variáveis acima (desenvolver sem mexer nos dados reais).
ARMAZENAMENTO=
