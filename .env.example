FEATHERLESS_API_KEY=
ANALYST_MODEL=zai-org/GLM-5.2
EVALUATOR_MODEL=zai-org/GLM-5.2
FAST_MODEL=

# Slack (lib/slack) — sem SLACK_BOT_TOKEN roda em modo simulado (só loga).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# URL pública da sala de entrevista (provisório até a chamada própria existir)
APP_BASE_URL=http://localhost:3000

# Email (lib/email) — domínio interview.entoa.app verificado no Resend.
# Sem RESEND_API_KEY o envio é simulado apenas fora de produção; em produção
# falhas viram erro 502.
RESEND_API_KEY=
EMAIL_FROM="Converge Challenge <entrevistas@interview.entoa.app>"
# Segredo compartilhado exigido no header x-api-key das rotas /api/email/*.
# Sem ele, as rotas respondem 401 (fail closed).
EMAIL_API_SECRET=
# Opcional: endereço pra onde vão as respostas dos candidatos.
EMAIL_REPLY_TO=
# Opcional: fuso exibido nos emails (padrão America/Sao_Paulo).
EMAIL_TIMEZONE=

# Só para a demo do Slack (/api/slack/demo): todos os emails de teste vão para este endereço.
DEMO_EMAIL=

# Cérebro: geração de kits de avaliação a partir da vaga (lib/agente/kits/gerar.ts)
# Segredo exigido no header x-api-key das rotas /api/avaliacoes/*. Sem ele, 401 (fail closed).
AVALIACOES_API_SECRET=
# Modelo da geração do kit (1 chamada com raciocínio, ~1-2 min). Padrão: anthropic/claude-opus-5.5.
# Se esse id não existir na OpenRouter, use anthropic/claude-sonnet-5.5.
AGENTE_MODELO_FINAL=
# 1 = permite abrir sessão para uma avaliação GERADA ainda não aprovada (só para demos/testes).
# Padrão: sessões de avaliações geradas exigem aprovação humana (POST /api/avaliacoes/[id]/aprovar).
AGENTE_PERMITIR_NAO_APROVADA=

# Cérebro (lib/agente) — LLM via OpenRouter, só no servidor (nunca NEXT_PUBLIC_*).
OPENROUTER_API_KEY=
# Análise e perguntas ao vivo. Padrão anthropic/claude-haiku-5.5 (confira o id em openrouter.ai/models).
AGENTE_MODELO_AO_VIVO=
# 1 = LLM falso determinístico, sem chave (só para testar o fluxo).
AGENTE_FAKE=
# 1 = libera rotas /dev e o scorecard no navegador mesmo em produção.
AGENTE_DEV=

# Quadro Excalidraw: 1 = chama as rotas reais do cérebro em vez dos dados de mentira.
NEXT_PUBLIC_USAR_SERVIDOR=
NEXT_PUBLIC_AVALIACAO_ID=demo
NEXT_PUBLIC_CANDIDATO_ID=demo
