FEATHERLESS_API_KEY=
ANALYST_MODEL=zai-org/GLM-5.2
EVALUATOR_MODEL=zai-org/GLM-5.2
FAST_MODEL=

# Email (lib/email) — conta em modo sandbox: só entrega no endereço
# verificado da conta Resend. Sem RESEND_API_KEY o envio é simulado apenas
# fora de produção; em produção falhas viram erro 502.
RESEND_API_KEY=
EMAIL_FROM="Converge Challenge <onboarding@resend.dev>"
# Segredo compartilhado exigido no header x-api-key das rotas /api/email/*.
# Sem ele, as rotas respondem 401 (fail closed).
EMAIL_API_SECRET=
# Opcional: endereço pra onde vão as respostas dos candidatos.
EMAIL_REPLY_TO=
# Opcional: fuso exibido nos emails (padrão America/Sao_Paulo).
EMAIL_TIMEZONE=

# Cérebro: geração de kits de avaliação a partir da vaga (lib/agente/kits/gerar.ts)
# Segredo exigido no header x-api-key das rotas /api/avaliacoes/*. Sem ele, 401 (fail closed).
AVALIACOES_API_SECRET=
# Modelo da geração do kit (1 chamada com raciocínio, ~1-2 min). Padrão: anthropic/claude-opus-5.5.
# Se esse id não existir na OpenRouter, use anthropic/claude-sonnet-5.5.
AGENTE_MODELO_FINAL=
# 1 = permite abrir sessão para uma avaliação GERADA ainda não aprovada (só para demos/testes).
# Padrão: sessões de avaliações geradas exigem aprovação humana (POST /api/avaliacoes/[id]/aprovar).
AGENTE_PERMITIR_NAO_APROVADA=
