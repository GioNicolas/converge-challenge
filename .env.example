FEATHERLESS_API_KEY=
ANALYST_MODEL=zai-org/GLM-5.3-Flash
EVALUATOR_MODEL=zai-org/GLM-5.2
FAST_MODEL=google/gemma-4-31B-it
INTERVIEWER_MODEL=zai-org/GLM-5.3-Flash

# Reserva: só entra quando a Featherless falha ou demora demais
OPENROUTER_API_KEY=
ANALYST_FALLBACK_MODEL=z-ai/glm-5.3-flash
FAST_FALLBACK_MODEL=openai/gpt-oss-120b
EVALUATOR_FALLBACK_MODEL=z-ai/glm-5.2
INTERVIEWER_FALLBACK_MODEL=z-ai/glm-5.3-flash

# Pré-entrevista (Totti)
TYPESAFE_API_KEY=
EXTRACTOR_MODEL=zai-org/GLM-5.2
EXTRACTOR_FALLBACK_MODEL=google/gemini-2.5-flash-lite
CONVERSA_MODEL=google/gemma-4-26B-A4B-it
CONVERSA_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Pré-entrevista no workspace: 1 usa as rotas reais; sem, demonstração roteirizada
NEXT_PUBLIC_USAR_SERVIDOR=1

# Transcrição da fala do candidato (rota /api/stt-token): a chave fica só no servidor e o
# navegador recebe um token temporário. Sem a chave, cai na transcrição do navegador.
ELEVENLABS_API_KEY=

# Email (lib/email) — domínio interview.entoa.app verificado no Resend.
# Sem RESEND_API_KEY o envio é simulado apenas fora de produção; em produção
# falhas viram erro 502.
RESEND_API_KEY=
EMAIL_FROM="Converge Challenge <entrevistas@interview.entoa.app>"
# Segredo compartilhado exigido no header x-api-key das rotas /api/email/*.
# Sem ele, as rotas respondem 401 (fail closed).
EMAIL_API_SECRET=
# Opcional: endereço pra onde vão as respostas dos candidatos.
EMAIL_REPLY_TO=
# Opcional: fuso exibido nos emails (padrão America/Sao_Paulo).
EMAIL_TIMEZONE=
# Candidatos de teste (o time): aparecem como inscritos em toda vaga e são os ÚNICOS que recebem email de verdade.
# Formato: Nome Sobrenome <email>; Outro Nome <email2>
CANDIDATOS_TESTE=
# Opcional: URL pública do app nos links dos emails (padrão: a origem da requisição).
APP_URL=
