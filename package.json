{
  "name": "converge-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "pre:classificar": "tsx --env-file-if-exists=.env.local scripts/pre-entrevista/classificar.ts",
    "pre:extrair": "tsx --env-file-if-exists=.env.local scripts/pre-entrevista/extrair.ts",
    "pre:simular": "tsx --env-file-if-exists=.env.local scripts/pre-entrevista/simular.ts",
    "test:email": "tsx --test lib/email/__tests__/*.test.ts",
    "test:convites": "tsx --test lib/convites/__tests__/*.test.ts",
    "test:pre-entrevista": "tsx --test lib/pre-entrevista/__tests__/*.test.ts",
    "test:e2e": "playwright test",
    "test:agente": "tsx --test lib/agente/__tests__/*.test.ts lib/agente/**/__tests__/*.test.ts",
    "test:rotas": "tsx --test app/api/__tests__/*.test.ts lib/agente/armazenamento/__tests__/*.test.ts",
    "test:entrevista-texto": "tsx --test lib/dev/entrevista-texto/__tests__/*.test.ts lib/agente/__tests__/scorecard.test.ts app/api/__tests__/entrevista-texto.test.ts",
    "test:scorecard": "tsx --test lib/agente/__tests__/scorecard*.test.ts",
    "eval:scorecard": "node --env-file-if-exists=.env.local --import tsx scripts/eval-scorecard.ts",
    "test:kits": "tsx --test lib/agente/kits/__tests__/*.test.ts",
    "test:vagas": "tsx --test lib/agente/kits/__tests__/vagas-*.test.ts app/api/__tests__/avaliacoes.test.ts",
    "test:squad": "tsx --test lib/squad-memory/__tests__/*.test.ts",
    "test:noventa-dias": "tsx --test lib/noventa-dias/__tests__/*.test.ts",
    "test:plano": "tsx --test lib/agente/planejamento/__tests__/*.test.ts app/api/__tests__/dev-plano.test.ts",
    "agente:chat": "tsx scripts/agente-chat.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.35.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.10.1",
    "next": "15.5.4",
    "pdfjs-dist": "6.4.299",
    "pyodide": "^0.26.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
